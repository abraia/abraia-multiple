{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abraia/vision-studio/schemas/pipeline-v2.schema.json",
  "title": "Abraia Vision Pipeline v2",
  "description": "Ordered frame pipeline configuration with optional media output consumed by Abraia Vision Studio and the Abraia runtime.",
  "type": "object",
  "required": ["version", "source", "steps"],
  "properties": {
    "version": {"const": 2},
    "source": {"$ref": "#/$defs/source"},
    "output": {"$ref": "#/$defs/output"},
    "steps": {
      "type": "array",
      "minItems": 0,
      "prefixItems": [{"$ref": "#/$defs/modelStep"}],
      "items": {"$ref": "#/$defs/step"}
    },
    "display": {"$ref": "#/$defs/display"}
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["src"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "src": {"oneOf": [{"type": "string"}, {"type": "integer"}]},
        "resolution": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "integer", "exclusiveMinimum": 0}
        },
        "fps": {"type": "integer", "exclusiveMinimum": 0},
        "calibration": {
          "type": "object",
          "properties": {
            "line_px": {"type": "array", "minItems": 2, "maxItems": 2},
            "known_length": {"type": "number", "exclusiveMinimum": 0},
            "unit": {"enum": ["mm", "cm", "µm"]},
            "pixels_per_unit": {"type": "number", "exclusiveMinimum": 0}
          },
          "required": ["line_px", "known_length", "unit", "pixels_per_unit"]
        },
        "video_unpaced": {"type": "boolean"},
        "options": {
          "type": "object",
          "description": "Optional settings for a registered source adapter.",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "properties": {
        "show": {"type": "boolean"},
        "render_results": {"type": "boolean"},
        "render_metrics": {"type": "boolean"},
        "dest": {"type": "string"}
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["type", "url"],
      "properties": {
        "type": {"const": "rtsp"},
        "url": {"type": "string", "pattern": "^rtsp://"},
        "bitrate": {"type": "integer", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "point": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false
    },
    "line": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/point"}
    },
    "polygon": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/point"}
    },
    "model": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string"},
        "task": {"type": "string"},
        "uri": {"type": "string"},
        "size": {"type": "string"},
        "labels": {"type": "array", "items": {"type": "string"}},
        "params": {"type": "object"},
        "conf_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "iou_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "approx": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "baseStep": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string"},
        "enabled": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "modelStep": {
      "allOf": [
        {"$ref": "#/$defs/baseStep"},
        {
          "properties": {
            "type": {"const": "model"},
            "model": {"$ref": "#/$defs/model"}
          },
          "required": ["model"]
        }
      ]
    },
    "step": {
      "oneOf": [
        {"$ref": "#/$defs/modelStep"},
        {
          "allOf": [
            {"$ref": "#/$defs/baseStep"},
            {"properties": {"type": {"const": "tracker"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/baseStep"},
            {
              "properties": {
                "type": {"const": "line_counter"},
                "line": {"$ref": "#/$defs/line"}
              },
              "required": ["line"]
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/baseStep"},
            {
              "properties": {
                "type": {"const": "region_filter"},
                "polygon": {"$ref": "#/$defs/polygon"}
              },
              "required": ["polygon"]
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/baseStep"},
            {
              "properties": {
                "type": {"const": "region_timer"},
                "polygon": {"$ref": "#/$defs/polygon"}
              },
              "required": ["polygon"]
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/baseStep"},
            {
              "properties": {
                "type": {"const": "count"},
                "mode": {"enum": ["region", "line_crossing"]},
                "polygon": {"$ref": "#/$defs/polygon"},
                "line": {"$ref": "#/$defs/line"},
                "track_thresh": {"type": "number", "minimum": 0, "maximum": 1},
                "track_buffer": {"type": "integer", "minimum": 1},
                "match_thresh": {"type": "number", "minimum": 0, "maximum": 1}
              },
              "required": ["mode"]
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/baseStep"},
            {
              "properties": {
                "type": {"const": "measure"},
                "features": {"type": "array", "items": {"type": "string"}},
                "time_in_region": {"type": "boolean"},
                "polygon": {"$ref": "#/$defs/polygon"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/baseStep"},
            {
              "properties": {
                "type": {"const": "decision"},
                "metric": {"type": "string"},
                "operator": {"enum": ["gt", "gte", "lt", "lte", "eq", "range"]},
                "threshold": {"type": "number"},
                "lower_threshold": {"type": "number"},
                "upper_threshold": {"type": "number"}
              },
              "required": ["metric", "operator"]
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/baseStep"},
            {
              "properties": {
                "type": {"const": "filter"},
                "labels": {"type": "array", "items": {"type": "string"}},
                "min_confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "region_enabled": {"type": "boolean"},
                "polygon": {"$ref": "#/$defs/polygon"}
              }
            }
          ]
        }
      ]
    }
  }
}
